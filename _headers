/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

/*.html
  Cache-Control: no-cache

/*.json
  Cache-Control: public, max-age=300

# The Atlas mission planner may frame ONLY the two native maps in same-origin pages.
# Other site pages, including any future signup, retain global DENY.
/atlas-online.html
  ! X-Frame-Options
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: frame-ancestors 'self'

/atlas-cayo.html
  ! X-Frame-Options
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: frame-ancestors 'self'

# The optional account and its progress-transfer UI must never be cached
# or framed as a third-party sign-in surface.
/atlas-account.html
  Cache-Control: no-store
  Referrer-Policy: no-referrer
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; connect-src 'self' https://dwqrmgeldssozgdtidla.supabase.co; img-src 'self' data:; style-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

/atlas355-auth-config.js
  Cache-Control: no-store


# Avoid stale legacy UI after a new Cloudflare deployment. Preserve browser
# revalidation rather than forcing no-store on large maps or user data.
/*.js
  Cache-Control: no-cache

/*.css
  Cache-Control: no-cache

/atlas132-page-directory.json
  Cache-Control: no-cache
